 "components": {
  "schemas": {
   "Decision": {
    "properties": {
     "alias_a": {
      "type": "string",
      "format": "uuid",
      "title": "Alias A"
     },
     "alias_b": {
      "type": "string",
      "format": "uuid",
      "title": "Alias B"
     },
     "same": {
      "type": "boolean",
      "title": "Same"
     }
    },
    "type": "object",
    "required": [
     "alias_a",
     "alias_b",
     "same"
    ],
    "title": "Decision"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ImportIn": {
    "properties": {
     "source": {
      "type": "string",
      "pattern": "^erp-extract$",
      "title": "Source",
      "description": "The one connector in this build: a deterministic synthetic ERP / AP / card extract",
      "default": "erp-extract"
     },
     "fiscal_year": {
      "type": "string",
      "pattern": "^(latest|previous|oldest)$",
      "title": "Fiscal Year",
      "default": "latest"
     }
    },
    "type": "object",
    "title": "ImportIn"
   },
   "ResolveIn": {
    "properties": {
     "decisions": {
      "items": {
       "$ref": "#/components/schemas/Decision"
      },
      "type": "array",
      "maxItems": 200,
      "title": "Decisions",
      "description": "Human merge / split decisions; they override the model and are remembered"
     }
    },
    "type": "object",
    "title": "ResolveIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}